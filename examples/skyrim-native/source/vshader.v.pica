; Original minimal PICA200 vertex shader: CPU builds camera-relative marker triangles.
.fvec projection[4]
.constf one(0.0, 1.0, 0.0, 0.0)
.alias pos v0
.out outpos position
.out outclr color
.proc main
    mov r0.xyz, pos
    mov r0.w, one.y
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mov outclr, one.yyyy
    end
.end
