; Original minimal PICA200 vertex shader: CPU builds camera-relative marker triangles.
.fvec projection[4]
.constf one(0.0, 1.0, 0.0, 0.0)
.alias pos v0
.out outpos position
.out outclr color
.alias vertexColor v2
.out outtc0 texcoord0
.alias intex v1
.proc main
    mov r0.xyz, pos
    mov r0.w, one.y
    dp4 outpos.x, projection[0], r0
    dp4 outpos.y, projection[1], r0
    dp4 outpos.z, projection[2], r0
    dp4 outpos.w, projection[3], r0
    mov outtc0, intex
    mov outclr, vertexColor
    end
.end
